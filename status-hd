#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

OUT_DIR="/sdcard/DCIM/WA_Status_HD"
mkdir -p "$OUT_DIR"

banner() {
    clear
    echo -e "${CYAN}${BOLD}"
    cat << "EOF"
  ___ _        _              _  _ ___  
 / __| |_ __ _| |_ _  _ ___  | || |   \ 
 \__ \  _/ _` |  _| || (_-<  | __ | |) |
 |___/\__\__,_|\__|\_,_/__/  |_||_|___/ 
EOF
    echo -e "${NC}${GREEN}  WA Status Optimizer & Splitter${NC}"
    echo -e "${YELLOW}  License (c) 2026 account_limited${NC}"
    echo -e "${BLUE}==========================================${NC}\n"
}

get_size() {
    local f="$1"
    if [ -f "$f" ]; then
        local b=$(stat -c%s "$f" 2>/dev/null || wc -c < "$f")
        awk "BEGIN {printf \"%.2f MB\", $b/1048576}"
    else
        echo "0 MB"
    fi
}

get_dim() {
    local f="$1"
    local dim=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 "$f" 2>/dev/null | head -n 1)
    local w=$(echo "$dim" | cut -d'x' -f1)
    local h=$(echo "$dim" | cut -d'x' -f2)

    local rot=$(ffprobe -v error -select_streams v:0 -show_entries stream_tags=rotate -of default=noprint_wrappers=1:nokey=1 "$f" 2>/dev/null)
    if [[ "$rot" == "90" || "$rot" == "270" || "$rot" == "-90" ]]; then
        local tmp=$w
        w=$h
        h=$tmp
    fi

    if [ -n "$w" ] && [ -n "$h" ]; then
        if [ "$w" -gt "$h" ]; then
            echo "Landscape (${w}x${h})"
        elif [ "$w" -eq "$h" ]; then
            echo "Square (${w}x${h})"
        else
            echo "Portrait (${w}x${h})"
        fi
    else
        echo "Unknown"
    fi
}

scan_media() {
    command -v termux-media-scan &> /dev/null && termux-media-scan -r "$1" &> /dev/null
}

banner

INPUT=""
TMP_FILE=""

if [ -n "$1" ] && [ -f "$1" ]; then
    INPUT="$1"
    echo -e "${GREEN}[+] Loaded from Share menu:${NC} $(basename "$INPUT")\n"
else
    echo -e "${CYAN}${BOLD}Media Source:${NC}"
    echo "  1) Scan 10 recent files"
    echo "  2) Pick from Gallery / File Manager"
    echo "  3) Enter filename manually"
    echo "  0) Exit"
    read -p "Select [0-3]: " SRC

    if [ "$SRC" == "0" ] || [ "$SRC" == "exit" ]; then
        exit 0
    elif [ "$SRC" == "2" ]; then
        if command -v termux-storage-get &> /dev/null; then
            mkdir -p ~/.cache/status-hd
            TMP_FILE="$HOME/.cache/status-hd/pick_$(date +%s)"
            echo -e "\n${YELLOW}[*] Opening file picker...${NC}"
            termux-storage-get "$TMP_FILE"
            sleep 1
            [ -f "$TMP_FILE" ] && INPUT="$TMP_FILE"
        else
            echo -e "\n${RED}[!] termux-storage-get unavailable. Falling back to manual.${NC}"
        fi
    elif [ "$SRC" == "1" ]; then
        echo -e "\n${YELLOW}[*] Scanning recent media...${NC}"
        mapfile -t FILES < <(find /sdcard/DCIM/Camera /sdcard/Download /sdcard/Movies /sdcard/Pictures -maxdepth 2 -type f \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.mov" -o -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -n 10 | cut -d' ' -f2-)

        if [ ${#FILES[@]} -gt 0 ]; then
            echo -e "${CYAN}Recent files:${NC}"
            for i in "${!FILES[@]}"; do
                echo -e "  ${BOLD}$((i+1)))${NC} $(basename "${FILES[$i]}") ${YELLOW}[$(get_size "${FILES[$i]}")]${NC}"
            done
            echo -e "  ${BOLD}0)${NC} Exit\n"
            read -p "Select [0-${#FILES[@]}]: " CHOICE

            [ "$CHOICE" == "0" ] || [ "$CHOICE" == "exit" ] && exit 0
            if [[ "$CHOICE" =~ ^[1-9]$|^10$ ]] && [ "$CHOICE" -le "${#FILES[@]}" ]; then
                INPUT="${FILES[$((CHOICE-1))]}"
            fi
        else
            echo -e "${YELLOW}[!] No recent media found.${NC}"
        fi
    fi

    if [ -z "$INPUT" ]; then
        echo ""
        read -p "Filename: " FNAME
        [ "$FNAME" == "exit" ] && exit 0
        INPUT=$(find /sdcard/Download /sdcard/DCIM /sdcard/Movies /sdcard/Pictures -name "$FNAME" 2>/dev/null | head -n 1)
    fi
fi

if [ -z "$INPUT" ] || [ ! -f "$INPUT" ]; then
    echo -e "\n${RED}[!] File not found.${NC}"
    [ -n "$TMP_FILE" ] && rm -f "$TMP_FILE"
    exit 1
fi

ORIG_SIZE=$(get_size "$INPUT")

if [ -n "$TMP_FILE" ]; then
    BASE="WA_$(date +%Y%m%d_%H%M%S)"
    MIME=$(file --mime-type -b "$INPUT" 2>/dev/null)
    if [[ "$MIME" == video/* ]]; then
        EXT="mp4"
    elif [[ "$MIME" == image/* ]]; then
        EXT="jpg"
    else
        EXT=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_type -of default=noprint_wrappers=1:nokey=1 "$INPUT" 2>/dev/null | grep -q "video" && echo "mp4" || echo "jpg")
    fi
else
    BASE=$(basename "${INPUT%.*}")
    EXT=$(echo "${INPUT##*.}" | tr '[:upper:]' '[:lower:]')
fi

echo -e "\n${CYAN}[i] Resolution:${NC} $(get_dim "$INPUT")"

echo -e "\n${CYAN}${BOLD}Background Blur (9:16):${NC}"
echo "  1) Use Blur"
echo "  2) No Blur"
read -p "Select [1/2]: " BLUR

if [ "$BLUR" == "1" ]; then
    VF="split[a][b];[b]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,boxblur=20:5[bg];[a]scale=1080:-2:force_original_aspect_ratio=decrease[fg];[bg][fg]overlay=(W-w)/2:(H-h)/2"
    BLUR_TXT="Yes (9:16)"
else
    VF="scale='min(1080,iw)':-2"
    BLUR_TXT="No"
fi

if [[ "$EXT" == "mp4" || "$EXT" == "mkv" || "$EXT" == "mov" ]]; then
    echo -e "\n${CYAN}${BOLD}Split Duration:${NC}"
    echo "  1) 30 seconds"
    echo "  2) 60 seconds"
    echo "  3) No split"
    read -p "Select [1/2/3]: " SPLIT

    echo -e "\n${YELLOW}[*] Encoding video...${NC}"

    if [ "$SPLIT" == "1" ] || [ "$SPLIT" == "2" ]; then
        [ "$SPLIT" == "1" ] && SEC=30 || SEC=60
        OUT="$OUT_DIR/${BASE}_part%02d.mp4"

        ffmpeg -hide_banner -loglevel error -stats -i "$INPUT" \
            -vf "$VF" \
            -c:v libx264 -preset medium -b:v 4000k -maxrate 4500k -bufsize 8000k \
            -r 30 -pix_fmt yuv420p \
            -g 60 -keyint_min 60 -sc_threshold 0 \
            -c:a aac -b:a 128k -ar 44100 \
            -f segment -segment_time "$SEC" -reset_timestamps 1 \
            -movflags +faststart \
            -y "$OUT"

        scan_media "$OUT_DIR"

        echo -e "\n${BLUE}==========================================${NC}"
        echo -e "${GREEN}${BOLD}[✓] Done! Split into ${SEC}s segments.${NC}"
        echo -e "    Blur   : ${CYAN}$BLUR_TXT${NC}"
        echo -e "    Input  : ${YELLOW}$ORIG_SIZE${NC}"
        echo -e "    Output : ${CYAN}$OUT_DIR${NC}"
        echo -e "${BLUE}==========================================${NC}"
    else
        OUT="$OUT_DIR/${BASE}_WA.mp4"

        ffmpeg -hide_banner -loglevel error -stats -i "$INPUT" \
            -vf "$VF" \
            -c:v libx264 -preset medium -b:v 4000k -maxrate 4500k -bufsize 8000k \
            -r 30 -pix_fmt yuv420p \
            -c:a aac -b:a 128k -ar 44100 \
            -movflags +faststart \
            -y "$OUT"

        scan_media "$OUT"

        echo -e "\n${BLUE}==========================================${NC}"
        echo -e "${GREEN}${BOLD}[✓] Done!${NC}"
        echo -e "    Blur   : ${CYAN}$BLUR_TXT${NC}"
        echo -e "    Size   : ${YELLOW}$ORIG_SIZE${NC} -> ${GREEN}${BOLD}$(get_size "$OUT")${NC}"
        echo -e "    Output : ${CYAN}$OUT${NC}"
        echo -e "${BLUE}==========================================${NC}"
    fi

elif [[ "$EXT" == "jpg" || "$EXT" == "jpeg" || "$EXT" == "png" ]]; then
    OUT="$OUT_DIR/${BASE}_WA.jpg"
    echo -e "\n${YELLOW}[*] Processing image...${NC}"

    ffmpeg -hide_banner -loglevel error -stats -i "$INPUT" \
        -vf "$VF" \
        -q:v 2 \
        -y "$OUT"

    scan_media "$OUT"

    echo -e "\n${BLUE}==========================================${NC}"
    echo -e "${GREEN}${BOLD}[✓] Done!${NC}"
    echo -e "    Blur   : ${CYAN}$BLUR_TXT${NC}"
    echo -e "    Size   : ${YELLOW}$ORIG_SIZE${NC} -> ${GREEN}${BOLD}$(get_size "$OUT")${NC}"
    echo -e "    Output : ${CYAN}$OUT${NC}"
    echo -e "${BLUE}==========================================${NC}"
else
    echo -e "\n${RED}[!] Unsupported format: $EXT${NC}"
fi

[ -n "$TMP_FILE" ] && rm -f "$TMP_FILE"

if [ -n "$1" ]; then
    echo ""
    read -p "Press [Enter] to exit..."
fi
